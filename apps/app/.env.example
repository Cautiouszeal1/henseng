# HENSENG super app — copy to .env.local
# URL of the HENSENG API (apps/web). Leave empty for an offline build where chats
# and communities show labelled previews.
EXPO_PUBLIC_API_URL=""

# End-to-end encrypted chats over XMTP: "dev" (XMTP test network), "production",
# or empty to show the labelled chat preview. iOS/Android need a dev build
# (eas build --profile development); Expo Go can't load XMTP's native module.
# "memory" is a simulated, unencrypted client for UI tests only — never ship it.
EXPO_PUBLIC_XMTP_ENV=""
