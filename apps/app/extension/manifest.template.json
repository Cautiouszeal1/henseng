{
  "manifest_version": 3,
  "name": "HENSENG — Chat, Communities & Wallet",
  "short_name": "HENSENG",
  "description": "Private encrypted chats, communities and a self-custody wallet for Ethereum, Base, Arbitrum and Solana.",
  "version": "__VERSION__",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open HENSENG", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" }
}
