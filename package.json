{
  "name": "henseng",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "pnpm --filter @henseng/web dev",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @henseng/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm --filter @henseng/web lint",
    "db:generate": "pnpm --filter @henseng/db generate",
    "db:migrate": "pnpm --filter @henseng/db migrate:dev",
    "db:deploy": "pnpm --filter @henseng/db migrate:deploy",
    "db:seed": "pnpm --filter @henseng/db seed",
    "app": "pnpm --filter @henseng/app start",
    "app:web": "pnpm --filter @henseng/app web",
    "app:build:web": "pnpm --filter @henseng/app build:web"
  }
}
