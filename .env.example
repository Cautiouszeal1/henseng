# HENSENG environment template — placeholders only. Never commit real values.

# PostgreSQL (Neon in staging/production; docker-compose locally)
DATABASE_URL="postgresql://henseng:henseng@localhost:5432/henseng"

# Session encryption — 32+ random characters (e.g. `openssl rand -base64 32`)
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public site URL — used as the SIWE domain/origin check
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WalletConnect project ID (https://dashboard.walletconnect.com). Leave empty to
# disable WalletConnect; injected browser wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Comma-separated wallet addresses granted SUPER_ADMIN on first sign-in (bootstrap only)
ADMIN_BOOTSTRAP_ADDRESSES=""

# Server-only RPC URLs (optional; public RPCs are used if empty)
RPC_URL_1=""
RPC_URL_8453=""
RPC_URL_42161=""
RPC_URL_11155111=""
RPC_URL_84532=""

# Provider keys — Phase 2/3. Server-only. Do not prefix with NEXT_PUBLIC_.
ZEROX_API_KEY=""
LIFI_API_KEY=""
LIFI_INTEGRATOR=""
UNISWAP_API_KEY=""

# Wallet USD prices (GET /api/v1/prices) come from CoinGecko's public API.
# Optional free "demo" key for higher rate limits: https://www.coingecko.com/en/api
COINGECKO_API_KEY=""

# Wallet history (incoming and outgoing transfers) and NFTs come from Alchemy, through
# the HENSENG API, so the key stays on the server. Free tier works: https://www.alchemy.com
# Without it, the app says history/NFTs aren't set up; sends made in HENSENG still show.
ALCHEMY_API_KEY=""

# Swaps and bridging (Phase 4) use LI.FI, which compares DEXs and bridges. Works without a key;
# a free key from https://portal.li.fi raises rate limits.
LIFI_API_KEY=""
# Optional HENSENG fee on swaps/bridges, collected by LI.FI for your integrator id
# (register at portal.li.fi). Example: 0.0025 = 0.25%. Capped at 3%. Shown to users in every quote.
LIFI_INTEGRATOR=""
SWAP_FEE=""

# Shown on /privacy (required by the App Store, Google Play and Chrome Web Store).
NEXT_PUBLIC_LEGAL_ENTITY=""
NEXT_PUBLIC_PRIVACY_EMAIL=""
